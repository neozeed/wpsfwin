//---------------------------------------------------------------------
// HEADER FILES
//---------------------------------------------------------------------
// Windows library header files.
#include <windows.h>
#include <winver.h>
// Workplace Shell resource ID's header file.
#include "resource.h"


//-----------------------------------------------------------------------------
// LOCAL CONSTANTS
//-----------------------------------------------------------------------------
// String constants used for version information and "Product Information" dialog.
#define VER_STR_PRODUCTNAME      "Workplace Shell for Windows\0"

//-----------------------------------------------------------------------------
// VERSION INFORMATION
//-----------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
   FILEVERSION     1,0,0,0
   PRODUCTVERSION  VER_MAJOR,VER_MINOR,0,0
   FILEFLAGSMASK   0
   FILEFLAGS       0
   FILEOS          VOS_DOS_WINDOWS16

   FILETYPE        VFT_APP
   FILESUBTYPE     VFT_APP

   BEGIN
      BLOCK "StringFileInfo"
      BEGIN
         BLOCK "040904E4"
         BEGIN
            VALUE "CompanyName"        , "IBM Corporation\0"
            VALUE "FileDescription"    , "Windows 3.1 Shell Replacement Program\0"
            VALUE "FileVersion"        , "1.0.0\0"
            VALUE "InternalName"       , "Workplace Shell\0"
            VALUE "LegalCopyright"     , VER_STR_PRODUCTCOPYRIGHT
            VALUE "ProductName"        , VER_STR_PRODUCTNAME
            VALUE "OriginalFileName"   , "WPSHELL.EXE\0"
            VALUE "ProductVersion"     , VER_STR_PRODUCTVERSION
         END
      END

      BLOCK "VarFileInfo"
      BEGIN
         VALUE "Translation", 0x0409, 1252
      END
   END


//-----------------------------------------------------------------------------
// ACCELERATOR TABLES
//-----------------------------------------------------------------------------
IDA_WPSHELL ACCELERATORS
{
   "K"       , ID_EVENT_SPECIAL      , VIRTKEY , NOINVERT , CONTROL, ALT, SHIFT
   VK_TAB    , ID_EVENT_PREVIOUS     , VIRTKEY , NOINVERT , SHIFT
   VK_LEFT   , ID_EVENT_LEFT         , VIRTKEY , NOINVERT
   VK_TAB    , ID_EVENT_NEXT         , VIRTKEY , NOINVERT
   VK_RIGHT  , ID_EVENT_RIGHT        , VIRTKEY , NOINVERT
   VK_UP     , ID_EVENT_UP           , VIRTKEY , NOINVERT
   VK_DOWN   , ID_EVENT_DOWN         , VIRTKEY , NOINVERT
   VK_NEXT   , ID_EVENT_PAGEDOWN     , VIRTKEY , NOINVERT
   VK_PRIOR  , ID_EVENT_PAGEUP       , VIRTKEY , NOINVERT
   VK_RETURN , ID_EVENT_OPEN         , VIRTKEY , NOINVERT
   VK_RETURN , ID_EVENT_SETTINGS     , VIRTKEY , NOINVERT , ALT
   VK_DELETE , ID_EVENT_DELETE       , VIRTKEY , NOINVERT
   VK_F1     , ID_EVENT_HELP         , VIRTKEY , NOINVERT
   VK_F1     , ID_EVENT_HELP         , VIRTKEY , NOINVERT , CONTROL
   "^S"      , ID_EVENT_SELECTALL    , NOINVERT
   "^D"      , ID_EVENT_DESELECTALL  , NOINVERT
   VK_ESCAPE , ID_EVENT_DESELECTALL  , VIRTKEY , NOINVERT
   VK_F10    , ID_EVENT_DESKTOP_POPUP, VIRTKEY , NOINVERT, SHIFT
}


