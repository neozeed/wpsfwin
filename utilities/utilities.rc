#include <windows.h>
#include "../resources/native.rc"
1700 DIALOGEX 0,0,360,200
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LaunchPad"
FONT 9,"MS Shell Dlg"
BEGIN
 LTEXT "Drop programs, shortcuts, documents or folders here:",-1,8,8,340,12
 LISTBOX 1701,8,24,344,138,LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
 DEFPUSHBUTTON "Launch",IDOK,8,174,76,18
 PUSHBUTTON "Add...",1702,96,174,76,18
 PUSHBUTTON "Remove",1703,184,174,76,18
 PUSHBUTTON "Close",IDCANCEL,276,174,76,18
END
1705 DIALOGEX 0,0,230,85
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Windows shutdown utility"
FONT 9,"MS Shell Dlg"
BEGIN
 LTEXT "Choose an action for Windows:",-1,8,8,214,12
 COMBOBOX 1706,8,25,214,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "Continue...",IDOK,74,57,70,18
 DEFPUSHBUTTON "Cancel",IDCANCEL,152,57,70,18
END
